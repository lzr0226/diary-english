# Copy to .env.local for local cloud testing, or enter these in Vercel Settings.
NEXT_PUBLIC_APP_MODE=cloud
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon or publishable key only; never service_role / sb_secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional feedback email. Supabase Auth custom SMTP is configured separately in its dashboard.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Tencent ASR for Web voice input. Server only; no NEXT_PUBLIC prefix.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Optional identity binding: same secret in Vercel and CloudBase, at least 32 characters.
WECHAT_APPID=
WECHAT_BINDING_SECRET=
