# Website mode. No WeChat AppID and no Supabase credentials required.
NEXT_PUBLIC_APP_MODE=tencent
APP_ORIGIN=https://your-domain.example
TCB_ENV=
# Random secret, at least 32 characters. Rotation invalidates sessions/codes, not account IDs.
AUTH_SECRET=
# Server SDK credentials for the same CloudBase environment. Use a scoped service identity.
# Can be omitted only when the hosting runtime is configured with a working CloudBase service role.
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
