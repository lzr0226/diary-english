# Configure these ONLY in diaryApi cloud-function environment variables.
TCB_ENV=your-mainland-cloudbase-env-id
WECHAT_APPID=wx-your-real-appid
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# QQ mail uses SMTP authorization code, NOT the QQ login password.
SMTP_PASSWORD=
SMTP_FROM=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
# Optional Web identity binding. Same random >=32-character secret in Vercel.
WECHAT_BINDING_SECRET=
