page{background:#faf8f8;color:#333;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}
.page{padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom))}.title{font-size:42rpx;font-weight:700;margin:18rpx 0 30rpx}.subtitle{color:#a45a6d;letter-spacing:3rpx;font-size:22rpx}.muted{color:#888;font-size:24rpx}.card{background:#fff;border:1rpx solid #eee6e8;border-radius:24rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 4rpx 14rpx #51343f05}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.primary{background:#f5d5dc;color:#923e55}.danger{color:#b64040}.error{background:#fff0ef;color:#a43535;padding:20rpx;border-radius:16rpx;margin:18rpx 0;word-break:break-all}.notice{color:#775763;background:#f7edf0;padding:20rpx;border-radius:16rpx;margin:18rpx 0}button{font-size:28rpx;border-radius:18rpx;margin:16rpx 0;min-height:88rpx;background:#f5f1f2}button::after{border:0}button[disabled]{opacity:.45}input,textarea,picker{box-sizing:border-box;width:100%;background:#f8f5f6;padding:22rpx;border-radius:16rpx;margin:16rpx 0}input{height:88rpx}textarea{min-height:300rpx}.english{font-family:Georgia,serif;font-size:34rpx;line-height:1.9;white-space:pre-wrap;word-break:break-word}.original{white-space:pre-wrap;word-break:break-word}.empty{text-align:center;padding:70rpx 25rpx;color:#888}.moods{display:flex;flex-wrap:wrap;gap:12rpx}.mood{width:22%;text-align:center;padding:12rpx 0;background:#faf7f8;border-radius:16rpx}.selected{background:#f8dfe6;color:#a24460;outline:1rpx solid #cb788f}.emoji{font-size:44rpx}.timeline{border-left:2rpx solid #eadce0;margin-left:26rpx;padding-left:30rpx}.time{margin-left:-52rpx;background:#faf8f8}.word{border-bottom:1rpx solid #eee;padding:22rpx 0}.term{font-size:34rpx;font-weight:600;color:#9d3d58}.grid{display:flex;flex-wrap:wrap;gap:16rpx}.photo{width:200rpx;height:200rpx;border-radius:14rpx}.stat{flex:1;text-align:center}.number{font-size:52rpx;font-weight:700}.bubble{padding:24rpx;border-radius:18rpx;background:#fff;margin:20rpx 0;white-space:pre-wrap}.user{background:#f8e4ea}.label{margin-top:22rpx;font-size:24rpx;color:#777}checkbox{transform:scale(.85)}.small{font-size:24rpx}.actions{display:flex;gap:16rpx}.actions button{flex:1}
