<view class="page"><view class="subtitle">日常里，拾起英语</view><view class="title">我的日记</view><input placeholder="搜索标题、原文或英文" value="{{query}}" bindinput="input"/><button class="primary" bindtap="create">＋ 写一篇日记</button><view wx:if="{{busy}}" class="notice">正在读取云端日记…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重新读取</button></view><view wx:if="{{!busy && !error && !items.length}}" class="empty">从今天的一件小事开始。</view><view class="timeline"><view wx:for="{{items}}" wx:key="id"><view class="time">{{item.emoji}}　{{item.dateLabel}}</view><view class="card" data-id="{{item.id}}" bindtap="open"><view>{{item.title || '无标题日记'}}</view><view class="muted">{{item.summary}}</view><view class="subtitle" wx:if="{{item.english}}">已有英文版本</view></view></view></view></view>
