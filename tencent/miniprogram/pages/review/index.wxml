<view class="page"><view class="title">今日复习</view><view class="muted">还剩 {{remaining}} 个词语</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="refresh">重新读取</button></view><view class="card" wx:if="{{word}}"><view class="english">{{word.term}}</view><view class="muted">{{word.phonetic}}</view><button wx:if="{{!shown}}" bindtap="reveal">想一想，再查看释义</button><block wx:if="{{shown}}"><view>{{word.partOfSpeech}}　{{word.meaningZh}}</view><view class="english">{{word.exampleSentence}}</view><button disabled="{{busy}}" data-rating="forgot" bindtap="rate">忘记 · 10 分钟后</button><button disabled="{{busy}}" data-rating="fuzzy" bindtap="rate">模糊 · 1 天后</button><button class="primary" disabled="{{busy}}" data-rating="remembered" bindtap="rate">记得 · 延长复习间隔</button></block></view><view wx:if="{{!word && !busy}}" class="empty">今天的复习已完成，明天继续。</view></view>
