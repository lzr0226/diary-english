<view class="page"><view class="error" wx:if="{{error}}">{{error}}<button bindtap="refresh">重试读取</button></view><view wx:if="{{busy}}" class="notice">处理中，请稍候…</view><view wx:if="{{!diary && !busy}}" class="empty">找不到这篇日记</view><block wx:if="{{diary}}"><view class="row"><view>{{diary.emoji}}　{{diary.dateLabel}}</view><button size="mini" disabled="{{busy}}" bindtap="edit">编辑</button></view><view class="title">{{diary.title}}</view><view class="card original">{{diary.original}}</view><view class="grid"><image wx:for="{{photos}}" wx:key="*this" class="photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview"/></view><view class="actions"><button disabled="{{busy}}" data-task="translate" bindtap="generate">翻译成英文</button><button disabled="{{busy}}" data-task="polish" bindtap="generate">润色英文</button></view><view wx:if="{{result}}" class="card"><view class="subtitle">待确认的 AI 结果</view><view class="english">{{result.resultText}}</view><view class="notice" wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view><view class="muted" wx:for="{{result.changes}}" wx:key="*this">{{item}}</view><button class="primary" disabled="{{busy}}" bindtap="adopt">确认采用</button><button disabled="{{busy}}" bindtap="discard">放弃结果</button></view><view class="card" wx:if="{{diary.english}}"><view class="subtitle">ENGLISH · 当前英文</view><view class="english" selectable="true">{{diary.english}}</view></view><view class="card" wx:if="{{diary.candidates.length}}"><view>候选词语 · 点击查看讲解</view><checkbox-group bindchange="select"><view wx:for="{{diary.candidates}}" wx:key="term" class="word"><label><checkbox value="{{index}}"/>{{item.term}}</label><view class="muted" data-index="{{index}}" bindtap="explain">{{item.partOfSpeech}}　{{item.meaningZh}}　›</view></view></checkbox-group><button class="primary" disabled="{{busy || !indices.length}}" bindtap="add">确认添加所选词语</button></view><button class="danger" disabled="{{busy}}" bindtap="remove">删除日记</button></block></view>
