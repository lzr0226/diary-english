<view class="page"><view class="subtitle">SHIYU · 拾语</view><view class="title">{{nickname}}</view><view class="muted">{{bio}}</view><view class="row"><view class="card stat"><view>日记篇数</view><view class="number">{{diaryCount}}</view></view><view class="card stat"><view>已积累生词</view><view class="number">{{wordCount}}</view></view></view><button data-page="album" bindtap="go">相册 · {{photoCount}} 张</button><view class="card"><input value="{{nickname}}" maxlength="40" data-field="nickname" bindinput="input" placeholder="昵称"/><textarea value="{{bio}}" maxlength="300" data-field="bio" bindinput="input" placeholder="个人签名"/><button disabled="{{busy || !nickname}}" bindtap="save">保存个人资料</button></view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="refresh">重新读取</button></view><button data-page="feedback" bindtap="go">问题反馈</button><view class="card"><view>关联 Web 账号</view><view class="muted">在 Web 版“我的 → 关联微信账号”生成一次性绑定码。仅关联身份，不自动合并日记。</view><input value="{{bindingCode}}" data-field="bindingCode" bindinput="input" maxlength="1500" placeholder="粘贴 10 分钟有效的绑定码"/><button disabled="{{busy || !bindingCode}}" bindtap="bind">确认关联账号</button><view class="notice" wx:if="{{bindingStatus}}">{{bindingStatus}}</view></view><button bindtap="export">导出我的数据</button><button data-page="privacy" bindtap="go">隐私与使用说明</button><button bindtap="logout">退出当前会话</button></view>
