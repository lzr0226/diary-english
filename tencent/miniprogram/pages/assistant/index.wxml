<view class="page"><view class="subtitle">从自己的故事开始练习</view><view class="title">AI 英语助手</view><button bindtap="newChat" disabled="{{busy}}">新建对话</button><picker disabled="{{busy}}" range="{{titles}}" value="{{selected}}" bindchange="select">关联：{{titles[selected]}}</picker><view wx:if="{{!messages.length}}" class="empty">解释日记中的语法，或用今天的生词出题。</view><view wx:for="{{messages}}" wx:key="index" class="bubble {{item.role==='user'?'user':''}}"><text selectable="true">{{item.content}}</text></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重新读取云端</button></view><textarea value="{{question}}" bindinput="input" maxlength="4000" placeholder="有什么英语问题想问？"/><button class="primary" loading="{{busy}}" disabled="{{busy || !question}}" bindtap="send">发送</button><view class="card"><view>历史对话</view><view class="row" wx:for="{{sessions}}" wx:key="id"><text data-id="{{item.id}}" bindtap="history">{{item.title}}</text><button size="mini" data-id="{{item.id}}" disabled="{{busy}}" bindtap="remove">删除</button></view></view></view>
