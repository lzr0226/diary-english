<view class="page"><view class="subtitle">每一个词，都来自你的生活</view><view class="title">我的生词本</view><input placeholder="搜索单词或中文意思" value="{{query}}" bindinput="input"/><button class="primary" bindtap="review">开始今日复习</button><view wx:if="{{busy}}" class="notice">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view class="card"><view wx:if="{{!words.length}}" class="empty">先在日记详情确认添加一些词语吧。</view><view wx:for="{{words}}" wx:key="id" class="word"><view data-id="{{item.id}}" bindtap="explain"><view class="term">{{item.term}}</view><view>{{item.partOfSpeech}}　{{item.meaningZh}}</view></view><view class="row"><view class="muted">{{item.status==='mastered'?'已掌握':item.status==='new'?'待学习':'学习中'}}</view><button size="mini" class="danger" data-id="{{item.id}}" disabled="{{busy}}" bindtap="remove">删除</button></view></view></view></view>
