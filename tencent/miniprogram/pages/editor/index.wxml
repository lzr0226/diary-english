<view class="page"><view class="title">写下今天</view><picker mode="date" value="{{date}}" bindchange="date">记录日期　{{date}}</picker><view class="moods"><view wx:for="{{moods}}" wx:key="id" class="mood {{mood===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="mood"><view class="emoji">{{item.emoji}}</view><view class="small">{{item.label}}</view></view></view><view class="card"><input placeholder="日记标题（选填）" maxlength="80" value="{{title}}" data-field="title" bindinput="input"/><textarea style="height:440rpx" placeholder="今天有什么想留下来？" maxlength="10000" value="{{original}}" data-field="original" bindinput="input"/><view class="muted">{{original.length}} / 10000</view></view><view class="notice">{{status}}</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="reload" disabled="{{busy}}">重新读取云端版本以核对</button></view><button class="primary" disabled="{{busy || recording || !original}}" loading="{{busy}}" bindtap="save">完成并同步云端</button><view class="card"><view>语音输入</view><picker range="{{languages}}" value="{{language}}" bindchange="language">{{languages[language]}}</picker><button disabled="{{busy || !speech}}" bindtap="voice">{{recording?'结束录音并识别':'开始语音输入'}}</button><view wx:if="{{!speech}}" class="muted">管理员尚未开通腾讯云语音识别，也可使用输入法语音。</view><block wx:if="{{transcript}}"><textarea value="{{transcript}}" data-field="transcript" bindinput="input"/><button bindtap="append">确认追加到正文</button><button bindtap="discard">放弃识别结果</button></block></view><button disabled="{{busy || images.length>=9}}" bindtap="photo">添加照片（{{images.length}} / 9）</button><view wx:for="{{images}}" wx:key="*this" class="row"><text>照片 {{index+1}}</text><button size="mini" data-index="{{index}}" bindtap="removePhoto">取消关联</button></view></view>
