# Default prototype needs no keys. Real adapters are server-only and not enabled automatically.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional direct feedback mail; all secrets remain server-side.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
